# Google Workspace SMTP Configuration for Contact Form
# 1. Turn on 2-Step Verification on the Google account (info@nairat.net)
# 2. Generate a 16-character App Password at https://myaccount.google.com/security
# 3. Enter credentials below:
EMAIL_USER=info@nairat.net
EMAIL_PASS=your-16-char-app-password
CONTACT_RECIPIENT_EMAIL=info@nairat.net

# Optional feature toggles
NEXT_PUBLIC_ENABLE_LANGUAGE_TOGGLE=false
